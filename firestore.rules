rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every read and write in this app happens server-side (Next.js Server
    // Components, Route Handlers, and scripts/seed-firestore.ts) via the
    // Admin SDK, which bypasses these rules entirely. No client ever talks
    // to Firestore directly — deny all direct client access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
