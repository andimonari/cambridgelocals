# Neon PostgreSQL — pooled connection (used at runtime by the app)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL — direct connection (used by Prisma CLI for migrations)
DATABASE_DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Local development only (no Neon):
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cambridge_locals?schema=public"
# DATABASE_DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/cambridge_locals?schema=public"

# Public base URL for sitemap, canonical URLs, and OG tags (no trailing slash)
# On Vercel staging: set to your .vercel.app URL
NEXT_PUBLIC_BASE_URL="https://www.cambridgelocals.com"

# NextAuth / Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-with-at-least-32-random-chars"

# Resend API key for email magic links (https://resend.com) — leave empty to use Credentials provider only
AUTH_RESEND_KEY=""

# From address for magic link emails (must be a verified Resend domain)
AUTH_EMAIL_FROM="Cambridge Locals <noreply@cambridgelocals.com>"
