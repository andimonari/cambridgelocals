# Firebase project — Project settings → General → Your apps (web app)
NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"

# Server-side (Admin SDK). In Firebase App Hosting this is provided
# automatically via Application Default Credentials — leave unset there.
# For local dev outside the emulator, generate a service account key
# (Project settings → Service accounts → Generate new private key), then
# base64-encode the downloaded JSON before pasting it here — e.g.:
#   base64 -i service-account.json | tr -d '\n'
# (Raw JSON also works if your shell sets this var directly via `export`,
# but base64 is what survives being parsed out of this file unmangled —
# some .env loaders corrupt the \n escapes inside the PEM private_key
# field when it's pasted as raw JSON.)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Set to "true" to point the app at local Firebase emulators
# (run with `npm run emulators`) instead of your real project.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Public base URL for sitemap, canonical URLs, and OG tags (no trailing slash)
NEXT_PUBLIC_BASE_URL="https://your-project-id.web.app"

# Resend API key (https://resend.com) for guide publish/reject email
# notifications — leave empty to just log emails to the console. Sign-in
# itself is Firebase Auth email-link, not Resend.
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="Cambridge Locals <noreply@cambridgelocals.com>"
