DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cambridge_experts?schema=public"

# Public base URL for sitemap, canonical URLs, and OG tags (no trailing slash)
NEXT_PUBLIC_BASE_URL="https://www.cambridgeexperts.com"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-at-least-32-random-chars"

# Resend API key for email magic links (https://resend.com)
AUTH_RESEND_KEY=""

# From address for magic link emails (must be a verified Resend domain)
AUTH_EMAIL_FROM="Cambridge Experts <noreply@cambridgeexperts.com>"
